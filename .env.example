# Environment variables for the Backend

# MongoDB Connection URI
# Example: MONGODB_URI="mongodb://localhost:27017/vendora"
# For MongoDB Atlas: MONGODB_URI="mongodb+srv://<username>:<password>@cluster-1.fgdfx1i.mongodb.net/<dbname>?retryWrites=true&w=majority"
MONGODB_URI="your_mongodb_connection_string"

# Port the Express server will listen on
PORT=5000

# Frontend URL (for CORS, redirect after OAuth, etc.)
FRONTEND_URL="http://localhost:5173"

# JSON Web Token (JWT) Secret for signing and verifying tokens
JWT_SECRET="your_jwt_secret_key_here"

# Google OAuth Configuration
GOOGLE_CLIENT_ID="your_google_client_id"
GOOGLE_CLIENT_SECRET="your_google_client_secret"
GOOGLE_CALLBACK_URL="/api/auth/google/callback" # Ensure this matches your Google project settings

# Session Secret for Express session middleware
SESSION_SECRET="a_strong_random_string_for_session_secret"

# Stripe Secret Key for payment processing
STRIPE_SECRET_KEY="your_stripe_secret_key"

# Email Configuration (e.g., SendGrid settings)
EMAIL_HOST="smtp.example.com"
EMAIL_PORT=587
EMAIL_USER="your_email_user"
EMAIL_PASS="your_email_password"
EMAIL_FROM_NAME="Your App Name"
EMAIL_FROM_ADDRESS="your_email@example.com"

# Gemini API Key (if applicable for any AI features)
GEMINI_API_KEY="your_gemini_api_key"